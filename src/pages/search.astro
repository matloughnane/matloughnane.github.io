---
import SearchResults from '../components/search/SearchResults.tsx';
import GlobalLayout from '../layouts/global-layout.astro';
import { getSortedPosts, albumGroup, GROUP_LABELS } from '../lib/posts';

// This page used to re-implement the glob/scrape logic from lib/posts.ts. That
// copy still used post.rawContent(), which Astro 7 no longer exposes on .mdx
// modules, so every search result came through with an empty description — and
// the description is half of what the filter matches on. Use the shared loader,
// which also drops drafts and WIP entries the way the rest of the album does.
//
// The caption is composed here rather than in the React component: albumGroup
// lives beside an import.meta.glob, and importing it client-side would pull
// every post into the browser bundle.
const posts = getSortedPosts().map((post) => {
    const group = albumGroup(post.categories);
    const stamped = new Date(post.date)
        .toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })
        .toUpperCase();

    return {
        title: post.title,
        slug: post.slug,
        image: post.image,
        description: post.description,
        caption: `${group ? GROUP_LABELS[group].toUpperCase() : 'ENTRY'} · ${stamped}`,
    };
});
---

<GlobalLayout title="Search" description="Search posts on Mat Loughnane's blog.">
    <section class="px-5 py-9 md:px-14 md:py-11">
        <SearchResults client:only="react" posts={posts} />
    </section>
</GlobalLayout>
