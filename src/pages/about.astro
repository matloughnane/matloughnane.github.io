---
import GlobalLayout from '../layouts/global-layout.astro';
---

<GlobalLayout
    title="About"
    description="Software developer from London, living in Dublin. Founder of Hexa Studios, passionate about cooking, baking, and exploring different cuisines while traveling the world."
>
    <section class="flex flex-col gap-4 pb-10">
        <h1 class="text-[19px] font-medium tracking-[-0.01em] text-fg">About</h1>
        <div class="flex max-w-[58ch] flex-col gap-5 text-[15px] leading-7 text-fg-muted">
            <p>
                I'm a software developer from London, living in Dublin. I enjoy
                cooking, especially baking to satisfy my sweet tooth, and
                exploring different cuisines on my travels.
            </p>
            <p>My favourite thing to make — carrot cake.</p>
            <p>
                I've been building web and mobile apps for over a decade, and
                run <a
                    href="https://hexastudios.co"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-fg underline decoration-line underline-offset-2 transition-colors hover:decoration-fg"
                    >Hexa Studios</a
                >. This site is where everything else goes.
            </p>
        </div>
    </section>

    <figure class="flex flex-col gap-3">
        <img
            src="/assets/images/about/about-profile-paris.jpeg"
            alt="Mat Loughnane in Paris, August 2025"
            class="h-auto w-full rounded-md border border-line"
        />
        <figcaption class="font-mono text-[13px] text-fg-muted">
            Paris, August 2025
        </figcaption>
    </figure>
</GlobalLayout>
