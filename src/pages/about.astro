---
import GlobalLayout from '../layouts/global-layout.astro';
---

<GlobalLayout
    title="About"
    description="Software developer from London, living in Dublin. Founder of Hexa Studios, passionate about cooking, baking, and exploring different cuisines while traveling the world."
>
    <main class="mx-auto max-w-4xl px-4 py-8 md:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="col-span-1">
                <h1
                    class="font-legend text-[44px] uppercase leading-none tracking-[0.02em] text-legend sm:text-[58px]"
                >
                    Mat<br />Loughnane
                </h1>
                <h2 class="py-6 font-legend text-[15px] uppercase tracking-[0.2em] text-legend-soft">
                    just a little about me
                </h2>
            </div>
            <div class="col-span-1">
                <p class="mb-6 max-w-[62ch] text-[17px] leading-7 text-legend">
                    I'm a software developer from London, living in Dublin. I
                    enjoy cooking, especially baking to satisfy my sweet tooth
                    and exploring different cuisines on my travels.
                </p>
                <p class="mb-6 max-w-[62ch] text-[17px] leading-7 text-legend">
                    My favourite thing to make - Carrot Cake
                </p>
                <div class="h-[350px] overflow-hidden bg-cloth-deep p-[6px] md:h-[550px]">
                    <img
                        class="w-full h-full object-cover"
                        src="/assets/images/about/about-profile-paris.jpeg"
                    />
                    <!-- src="/assets/images/about/about-profile.jpg" -->
                </div>
                <span class="my-6 block text-[16px] leading-6 text-legend-soft">
                    Learn more about my work at <a
                        href="https://hexastudios.co"
                        class="underline decoration-dashed underline-offset-4"
                        target="_blank">hexastudios.co</a
                    >
                </span>
            </div>
        </div>
    </main>
</GlobalLayout>
