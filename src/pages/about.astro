---
import GlobalLayout from '../layouts/global-layout.astro';
import MountedPhoto from '../components/album/mounted-photo.astro';
---

<GlobalLayout
    title="About"
    description="Software developer from London, living in Dublin. Founder of Hexa Studios, passionate about cooking, baking, and exploring different cuisines while traveling the world."
>
    <div class="px-5 py-9 md:px-14 md:py-12">
        <div
            class="mx-auto grid max-w-5xl grid-cols-1 gap-10 md:grid-cols-2 md:gap-14"
        >
            <div class="flex flex-col gap-5">
                <h1
                    class="font-display text-[46px] leading-[0.94] tracking-[-0.03em] text-ink sm:text-[62px]"
                >
                    Mat<br />Loughnane
                </h1>
                <p class="max-w-[60ch] text-[17px] leading-7 text-ink">
                    I'm a software developer from London, living in Dublin. I
                    enjoy cooking, especially baking to satisfy my sweet tooth
                    and exploring different cuisines on my travels.
                </p>
                <p class="text-[17px] leading-7 text-ink-2">
                    My favourite thing to make — carrot cake.
                </p>
                <p class="text-[15px] leading-6 text-ink-2">
                    Learn more about my work at <a
                        href="https://hexastudios.co"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline decoration-ink-2/50 transition-colors hover:text-ink hover:decoration-ink"
                        >hexastudios.co</a
                    >
                </p>
            </div>

            <figure class="flex flex-col gap-3">
                <MountedPhoto
                    src="/assets/images/about/about-profile-paris.jpeg"
                    alt="Mat Loughnane in Paris, August 2025"
                    loading="eager"
                    corner={32}
                    class="h-[380px] w-full md:h-[520px]"
                />
                <figcaption
                    class="font-caption text-[13px] tracking-[0.03em] text-ink-2"
                >
                    Paris, August 2025
                </figcaption>
            </figure>
        </div>
    </div>
</GlobalLayout>
