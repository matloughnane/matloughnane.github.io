---
import type { GetStaticPaths } from 'astro';
import GlobalLayout from '../../../layouts/global-layout.astro';
import LeadEntry from '../../../components/album/lead-entry.astro';
import EntryCard from '../../../components/album/entry-card.astro';
import CategoryMark from '../../../components/album/category-mark.astro';
import Pagination from '../../../components/posts/pagination.astro';
import {
    getSortedPosts,
    getCategoryCounts,
    getEntryCount,
    albumGroup,
    GROUP_LABELS,
    type AlbumGroup,
} from '../../../lib/posts';

// One shelf of the album at a time. The URLs are the shelf names —
// /posts/journeys, /posts/kitchen, /posts/builds — and they paginate the same
// way /posts does. Only those three params are ever generated, so this route
// never shadows /posts, /posts/2, or a dated post permalink.
export const getStaticPaths = (({ paginate }) => {
    const posts = getSortedPosts();
    const groups = Object.keys(GROUP_LABELS) as AlbumGroup[];

    return groups.flatMap((group) => {
        const shelf = posts.filter((post) => albumGroup(post.categories) === group);
        // Same shape as /posts: newest entry leads, the rest fill the grid.
        const [featured, ...rest] = shelf;
        return paginate(rest, {
            params: { group },
            pageSize: 12,
            props: { featured, group },
        });
    });
}) satisfies GetStaticPaths;

const { page, featured, group } = Astro.props;

const label = GROUP_LABELS[group as AlbumGroup];
const shelves = getCategoryCounts();
const total = getEntryCount();

const featuredPost = page.currentPage === 1 ? featured : undefined;
const gridPosts = page.data;

const filterBase =
    'inline-flex items-center gap-2 font-caption text-[12px] tracking-[0.14em] transition-colors md:text-[13px]';
const filterOn = 'border-b-2 border-ink pb-1 font-semibold text-ink';
const filterOff = 'border-b border-transparent pb-1 text-ink-2 hover:text-ink';
---

<GlobalLayout
    title={label}
    description={`Every ${label.toLowerCase()} entry in the album.`}
>
    <div class="flex flex-col gap-11 px-5 py-8 md:gap-12 md:px-14 md:py-11">
        <div class="flex flex-col gap-6">
            <h1
                class="font-display text-[42px] leading-[0.95] tracking-[-0.03em] text-ink sm:text-[54px]"
            >
                {label}
            </h1>

            <nav
                class="flex flex-wrap items-center gap-x-7 gap-y-3"
                aria-label="Filter entries by shelf"
            >
                <a href="/posts" class:list={[filterBase, filterOff]}>
                    ALL ENTRIES · {total}
                </a>
                {
                    shelves.map((shelf) => (
                        <a
                            href={`/posts/${shelf.group}`}
                            aria-current={
                                shelf.group === group ? 'page' : undefined
                            }
                            class:list={[
                                filterBase,
                                shelf.group === group ? filterOn : filterOff,
                            ]}
                        >
                            <CategoryMark group={shelf.group} size={15} />
                            {shelf.label.toUpperCase()} · {shelf.count}
                        </a>
                    ))
                }
            </nav>
        </div>

        {
            featuredPost && (
                <LeadEntry
                    title={featuredPost.title}
                    slug={featuredPost.slug}
                    image={featuredPost.image}
                    categories={featuredPost.categories}
                    description={featuredPost.description}
                    learnMore={featuredPost.learnMore}
                    date={featuredPost.date}
                />
            )
        }

        <section
            class="grid grid-cols-1 gap-x-10 gap-y-11 border-t border-edge pt-9 sm:grid-cols-2 lg:grid-cols-3"
        >
            {
                gridPosts.map((post) => (
                    <EntryCard
                        title={post.title}
                        slug={post.slug}
                        image={post.image}
                        categories={post.categories}
                        description={post.description}
                        date={post.date}
                    />
                ))
            }
        </section>

        <Pagination page={page} />
    </div>
</GlobalLayout>
