---
import GlobalLayout from '../../layouts/global-layout.astro';
import PostList from '../../components/std/post-list.astro';
import { getSortedPosts } from '../../lib/posts';

// The archive is 37 items — short enough to hold on one page, grouped by year.
// Pagination existed to make a card grid tolerable; a list does not need it,
// and /posts/2 stays valid so nothing that was linked breaks.
export function getStaticPaths() {
    return [{ params: { page: undefined } }, { params: { page: '2' } }];
}

const posts = getSortedPosts();
---

<GlobalLayout
    title="All Posts"
    description="Travel stories, food adventures, and coding insights from Mat Loughnane."
>
    <section class="flex flex-col gap-4 pb-10">
        <h1 class="text-[19px] font-medium tracking-[-0.01em] text-fg">
            Writing
        </h1>
        <p class="max-w-[58ch] text-[15px] leading-7 text-fg-muted">
            Everything, newest first — {posts.length} posts since 2020.
        </p>
    </section>

    <PostList posts={posts} grouped />
</GlobalLayout>
