---
import type { GetStaticPaths } from 'astro';
import GlobalLayout from '../../layouts/global-layout.astro';
import LeadCourse from '../../components/blind/lead-course.astro';
import Course from '../../components/blind/course.astro';
import Pagination from '../../components/posts/pagination.astro';
import {
    getSortedPosts,
    getDestinationCounts,
    getEntryCount,
} from '../../lib/posts';

export const getStaticPaths = (({ paginate }) => {
    // The newest course shows in the window; the rest wind past at 12 a page.
    const [featured, ...rest] = getSortedPosts();
    return paginate(rest, { pageSize: 12, props: { featured } });
}) satisfies GetStaticPaths;

const { page, featured } = Astro.props;

const featuredPost = page.currentPage === 1 ? featured : undefined;
const coursePosts = page.data;

const destinations = getDestinationCounts();
const total = getEntryCount();

const tab =
    'font-legend text-[15px] uppercase leading-none tracking-[0.16em] pb-1';
---

<GlobalLayout
    title="All Posts"
    description="Travel stories, food adventures, and coding insights..."
>
    <div class="px-4 py-6 md:px-8 md:py-8">
        <div class="flex flex-col gap-5">
            <h1
                class="font-legend text-[40px] uppercase leading-none tracking-[0.02em] text-legend sm:text-[52px]"
            >
                The whole roll
            </h1>

            <nav
                class="flex flex-wrap items-center gap-x-6 gap-y-3"
                aria-label="Filter by destination"
            >
                <a
                    href="/posts"
                    aria-current="page"
                    class:list={[tab, 'border-b-2 border-legend text-legend']}
                    >All · {total}</a
                >
                {
                    destinations.map((d) => (
                        <a
                            href={`/posts/${d.destination}`}
                            class:list={[
                                tab,
                                'border-b-2 border-transparent text-legend-soft hover:text-legend',
                            ]}
                        >
                            {d.label} · {d.count}
                        </a>
                    ))
                }
            </nav>
        </div>

        {
            featuredPost && (
                <div class="mt-8 border-2 border-legend">
                    <LeadCourse
                        title={featuredPost.title}
                        slug={featuredPost.slug}
                        image={featuredPost.image}
                        categories={featuredPost.categories}
                        description={featuredPost.description}
                        learnMore={featuredPost.learnMore}
                        date={featuredPost.date}
                    />
                </div>
            )
        }

        <section class="mt-10 border-t-2 border-legend">
            {
                coursePosts.map((post, i) => (
                    <Course
                        title={post.title}
                        slug={post.slug}
                        image={post.image}
                        categories={post.categories}
                        description={post.description}
                        date={post.date}
                        index={i}
                    />
                ))
            }
        </section>

        <div class="mt-8">
            <Pagination page={page} />
        </div>
    </div>
</GlobalLayout>
