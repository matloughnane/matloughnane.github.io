---
import BlindFooter from '../components/blind/blind-footer.astro';
import EyeletTape from '../components/blind/eyelet-tape.astro';
import BlindNav from '../components/blind/blind-nav.astro';
import '@fontsource/barlow-condensed/400.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    publishDate?: string;
    image?: string;
}
const { title, description, publishDate, image = '/og-image.jpg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />

        <!-- Resolve the theme before first paint: a stored choice wins, the OS
             setting decides otherwise. -->
        <script is:inline>
            (() => {
                const stored = localStorage.getItem('theme');
                const dark = stored
                    ? stored === 'dark'
                    : window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.classList.toggle('dark', dark);
            })();
        </script>

        <!-- Primary Meta Tags -->
        <title>{title} | Mat Loughnane</title>
        <meta name="title" content={`${title} | Mat Loughnane`} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={publishDate ? 'article' : 'website'} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={`${title} | Mat Loughnane`} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:site_name" content="Mat Loughnane" />
        {
            publishDate && (
                <meta property="article:published_time" content={publishDate} />
            )
        }

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={`${title} | Mat Loughnane`} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />

        <!-- Additional Meta Tags -->
        <meta name="author" content="Mat Loughnane" />
        <meta name="robots" content="index, follow" />
        <meta
            name="theme-color"
            media="(prefers-color-scheme: light)"
            content="#ede7d9"
        />
        <meta
            name="theme-color"
            media="(prefers-color-scheme: dark)"
            content="#0e2b20"
        />

        <!-- The signature moment: navigating does not fade or slide, it steps
             the roll. Cross-document view transitions carry the world's own
             motion across every route. -->
        <ClientRouter />
    </head>

    <body>
        <!--
        THESIS: The archive is a destination blind — a roll of dyed cloth
        courses stepping under one fixed window. It refuses the personal-site
        default of a hero above a grid of equal cards, and it refuses ranking by
        type size.
        OWN-WORLD: Three dyes and no more — bottle-green duck cloth drenched,
        chrome-yellow legends, bleached calico for prose. One condensed
        grotesque in caps. Courses cut on a bias with type level inside. Punched
        eyelet tape down one edge is the index. Controls take no dye, only
        stitch, punch and relief. Photographs are matted on cloth, never tinted.
        STORY: A visitor who knows Mat reads the board top-down — what is
        showing now, then everything behind it on the roll, then where each
        course is bound.
        FIRST VIEWPORT: Eyelet tape down the left trim; the window inset from
        it; the lead course alone printed dark on pale, its destination and
        matted photograph filling the window; the next courses stepping in
        beneath. Rank is inversion, never size.
        FORM: Depot destination blind — dealt as a challenger, chosen over the
        assigned direction. Seed key 6a75efd4.
        DEVIATIONS: prose is set in Barlow, the uncondensed cut of the same
        family, because a real blind carries no running text and condensed caps
        cannot hold a paragraph. Cloth ships as a CSS weave, not woven material.
        The step easing overshoots, which the craft floor flags as bounce; the
        committed world specifies "snaps one course, overshoots, settles", so
        the world wins — but it is one overshoot that settles, never an elastic
        oscillation.
        FINISH: unreviewed and undocumented is unfinished; this build ends with
        the finish review, the verdict, and DESIGN.md.
        -->
        <EyeletTape />
        <div class="md:pl-[72px]">
            <BlindNav />
            <main>
                <slot />
            </main>
            <BlindFooter />
        </div>
    </body>
</html>
