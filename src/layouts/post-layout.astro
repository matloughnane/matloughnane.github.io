---
import GlobalLayout from './global-layout.astro';

export interface Props {
    frontmatter: {
        title: string;
        author?: string;
        description?: string;
        publishDate?: string;
        categories?: string[];
        tags?: string[];
        image?: string;
        comments?: boolean;
        recipe?: boolean;
    };
}

const { frontmatter } = Astro.props;
const { title, author, description, publishDate, categories = [], image, tags = [] } = frontmatter;

// Extract date from the file path if publishDate is not provided
const filePath = Astro.url.pathname;
const dateMatch = filePath.match(/(\d{4}-\d{2}-\d{2})/);
const postDate = publishDate || (dateMatch ? dateMatch[0] : undefined);

// Create a proper description if not provided
const postDescription = description || `${title} - ${categories.join(', ')} post by Mat Loughnane. ${tags.length > 0 ? `Topics: ${tags.join(', ')}.` : ''}`;
---

<GlobalLayout
    title={title}
    description={postDescription}
    publishDate={postDate}
    image={image}
>
    <article class="mx-auto max-w-3xl px-4 py-8 md:px-8">
        <!-- Post Header -->
        <header class="mb-12">

            <!-- Featured Image -->
            {image && (
                <div class="mb-8">
                    <img
                        src={image}
                        alt={title}
                        class="w-full h-64 md:h-96 object-cover"
                    />
                </div>
            )}

            <!-- Title -->
            <h1 class="mb-3 font-legend text-[40px] uppercase leading-none tracking-[0.02em] text-legend sm:text-[52px]">
                {title}
            </h1>
        </header>

        <!-- Post Content -->
        <div class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-legend prose-headings:uppercase prose-headings:tracking-[0.02em] prose-headings:text-legend prose-p:text-legend prose-li:text-legend prose-strong:text-legend prose-a:text-legend prose-a:underline prose-a:decoration-dashed prose-a:underline-offset-4 prose-img:rounded-none">
            <slot />
        </div>

        <!-- Post Footer -->
        <footer class="mt-16 pt-8">
            {tags.length > 0 && (
                <div class="mb-6">
                    <div class="flex flex-wrap gap-2">
                        {tags.map((tag) => (
                            <span class="border border-seam px-3 py-1 font-legend text-[14px] uppercase tracking-[0.12em] text-legend-soft">
                                {tag}
                            </span>
                        ))}
                    </div>
                </div>
            )}
        </footer>
    </article>
</GlobalLayout>