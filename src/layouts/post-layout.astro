---
import GlobalLayout from './global-layout.astro';

export interface Props {
    frontmatter: {
        title: string;
        author?: string;
        description?: string;
        publishDate?: string;
        categories?: string[];
        tags?: string[];
        image?: string;
        comments?: boolean;
        recipe?: boolean;
    };
}

const { frontmatter } = Astro.props;
const {
    title,
    description,
    publishDate,
    categories = [],
    image,
    tags = [],
} = frontmatter;

const filePath = Astro.url.pathname;
const dateMatch = filePath.match(/(\d{4}-\d{2}-\d{2})/);
const postDate = publishDate || (dateMatch ? dateMatch[0] : undefined);

const postDescription =
    description ||
    `${title} — ${categories.join(', ')} post by Mat Loughnane.`;

const stamped = postDate
    ? new Date(postDate).toLocaleDateString('en-GB', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
      })
    : '';
---

<GlobalLayout
    title={title}
    description={postDescription}
    publishDate={postDate}
    image={image}
>
    <article>
        <header class="flex flex-col gap-3 pb-8">
            <h1
                class="text-[26px] font-medium leading-tight tracking-[-0.015em] text-fg"
            >
                {title}
            </h1>
            <div class="flex items-center gap-3 font-mono text-[13px] text-fg-muted">
                {stamped && <time datetime={postDate}>{stamped}</time>}
                {
                    categories.length > 0 && (
                        <>
                            <span aria-hidden="true">·</span>
                            <span>{categories.join(', ')}</span>
                        </>
                    )
                }
            </div>
        </header>

        {
            image && (
                <img
                    src={image}
                    alt={title}
                    class="mb-10 h-auto w-full rounded-md border border-line"
                />
            )
        }

        <div
            class="prose prose-neutral max-w-none dark:prose-invert prose-headings:font-medium prose-headings:tracking-[-0.01em] prose-h2:text-[19px] prose-h3:text-[17px] prose-p:text-[15px] prose-p:leading-7 prose-li:text-[15px] prose-a:text-fg prose-a:decoration-line hover:prose-a:decoration-fg prose-img:rounded-md prose-img:border prose-img:border-line prose-pre:border prose-pre:border-line"
        >
            <slot />
        </div>

        {
            tags.length > 0 && (
                <footer class="mt-12 flex flex-wrap gap-x-3 gap-y-2 border-t border-line pt-6">
                    {tags.map((tag) => (
                        <span class="font-mono text-[13px] lowercase text-fg-muted">
                            #{tag}
                        </span>
                    ))}
                </footer>
            )
        }

        <a
            href="/posts"
            class="mt-10 inline-block text-[14px] text-fg-muted transition-colors hover:text-fg"
            >← All posts</a
        >
    </article>
</GlobalLayout>
