---
import GlobalLayout from './global-layout.astro';
import MountedPhoto from '../components/album/mounted-photo.astro';
import CategoryMark from '../components/album/category-mark.astro';
import { albumGroup, GROUP_LABELS } from '../lib/posts';
import { blogPostingSchema, recipeSchema } from '../lib/structured-data';

export interface Props {
    frontmatter: {
        title: string;
        author?: string;
        description?: string;
        publishDate?: string;
        categories?: string[];
        tags?: string[];
        image?: string;
        comments?: boolean;
        recipe?: boolean;
        draft?: boolean;
        prepTime?: string;
        cookTime?: string;
        recipeYield?: string;
        recipeCategory?: string;
        recipeCuisine?: string;
        recipeIngredient?: string[];
        recipeInstructions?: string;
    };
    file: string;
}

const { frontmatter, file } = Astro.props;
const { title, author, description, publishDate, categories = [], image, tags = [] } = frontmatter;

// Extract date from the file path if publishDate is not provided
const filePath = Astro.url.pathname;
const dateMatch = filePath.match(/(\d{4}-\d{2}-\d{2})/);
const postDate = publishDate || (dateMatch ? dateMatch[0] : undefined);

// Create a proper description if not provided
const postDescription = description || `${title} - ${categories.join(', ')} post by Mat Loughnane. ${tags.length > 0 ? `Topics: ${tags.join(', ')}.` : ''}`;

const group = albumGroup(categories);

// Unfinished recipes still build, so keep them out of rich results until
// they have something to show.
const unfinished = frontmatter.draft || tags.some((tag) => tag.toLowerCase() === 'wip');
const schemaInput = {
    file,
    url: new URL(Astro.url.pathname, Astro.site),
    title,
    description: postDescription,
    image: new URL(image || '/og-image.jpg', Astro.site),
    datePublished: postDate,
    tags,
    frontmatter,
};
const schema = unfinished
    ? []
    : [frontmatter.recipe ? recipeSchema(schemaInput) : blogPostingSchema(schemaInput)];
const stamped = postDate
    ? new Date(postDate)
          .toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
          })
          .toUpperCase()
    : '';
---

<GlobalLayout
    title={title}
    description={postDescription}
    publishDate={postDate}
    image={image}
    schema={schema}
>
    <article class="mx-auto max-w-3xl px-5 py-9 md:px-8 md:py-12">
        <!-- Post Header -->
        <header class="mb-12">

            <!-- Mounted like every other photo in the album: the motif cannot
                 stop at the door of the entry you actually came to read. -->
            {image && (
                <MountedPhoto
                    src={image}
                    alt={title}
                    loading="eager"
                    corner={32}
                    class="mb-8 h-64 w-full md:h-96"
                />
            )}

            <!-- Title -->
            <h1
                class="mb-3 font-display text-[40px] leading-[0.98] tracking-[-0.03em] text-ink sm:text-[52px]"
            >
                {title}
            </h1>

            <!-- Caption under the title, the way it sits on a leaf. -->
            <div class="flex items-center gap-2 text-ink-2">
                <CategoryMark group={group} size={15} />
                <span class="font-caption text-[13px] tracking-[0.14em]">
                    {group ? GROUP_LABELS[group].toUpperCase() : 'ENTRY'}
                    {stamped && ` · ${stamped}`}
                </span>
            </div>
        </header>

        <!-- Post Content -->
        <div
            class="prose prose-lg max-w-none dark:prose-invert prose-headings:my-2 prose-headings:leading-tight prose-headings:text-ink prose-h2:text-3xl prose-h3:text-2xl prose-h4:text-xl prose-p:text-ink prose-a:text-ink prose-a:underline prose-a:decoration-ink-2/60 prose-a:underline-offset-4 prose-strong:text-ink prose-li:text-ink prose-img:rounded-none"
        >
            <slot />
        </div>

        <!-- Post Footer -->
        <footer class="mt-16 pt-8">
            {tags.length > 0 && (
                <div class="mb-6">
                    <div class="flex flex-wrap gap-2">
                        {tags.map((tag) => (
                            <span class="rounded-full border border-edge px-3 py-1 text-sm lowercase text-ink-2">
                                {tag}
                            </span>
                        ))}
                    </div>
                </div>
            )}
        </footer>
    </article>
</GlobalLayout>