---
import Arrow from '../album/arrow.astro';

// Prev/Next pagination controls driven entirely by Astro's `page` object.
// Renders nothing when there is only a single page.
export interface Props {
    page: {
        currentPage: number;
        lastPage: number;
        url: { prev?: string; next?: string };
    };
}

const { page } = Astro.props;
const { currentPage, lastPage, url } = page;

// Ink, not reserve: the saturated red marks the most recent entry and nothing
// else. Disabled state stays at full ink-2 — dimming it further drops it below
// the contrast floor, and the missing underline already reads as unavailable.
const linkClass =
    'inline-flex items-center gap-2 border-b border-ink pb-1 text-[15px] font-semibold text-ink transition-opacity hover:opacity-70';
const disabledClass =
    'inline-flex items-center gap-2 pb-1 text-[15px] font-semibold text-ink-2 cursor-not-allowed select-none';
---

{
    lastPage > 1 && (
        <nav
            class="flex items-center justify-between gap-4 pt-4"
            aria-label="Pagination"
        >
            {url.prev ? (
                <a href={url.prev} class={linkClass} rel="prev">
                    <Arrow direction="left" />
                    Previous
                </a>
            ) : (
                <span class={disabledClass} aria-hidden="true">
                    <Arrow direction="left" />
                    Previous
                </span>
            )}

            <span class="font-caption text-[13px] tracking-[0.1em] text-ink-2">
                PAGE {currentPage} OF {lastPage}
            </span>

            {url.next ? (
                <a href={url.next} class={linkClass} rel="next">
                    Next
                    <Arrow direction="right" />
                </a>
            ) : (
                <span class={disabledClass} aria-hidden="true">
                    Next
                    <Arrow direction="right" />
                </span>
            )}
        </nav>
    )
}
