---
// Prev/Next pagination controls driven entirely by Astro's `page` object.
// Renders nothing when there is only a single page.
export interface Props {
    page: {
        currentPage: number;
        lastPage: number;
        url: { prev?: string; next?: string };
    };
}

const { page } = Astro.props;
const { currentPage, lastPage, url } = page;

// Controls take no dye: stitch and relief only.
const linkClass =
    'inline-block border-b-2 border-dashed border-legend pb-1 font-legend text-[17px] uppercase leading-none tracking-[0.14em] text-legend';
const disabledClass =
    'inline-block pb-1 font-legend text-[17px] uppercase leading-none tracking-[0.14em] text-legend-soft cursor-not-allowed select-none';
---

{
    lastPage > 1 && (
        <nav
            class="flex items-center justify-between gap-4 pt-4"
            aria-label="Pagination"
        >
            {url.prev ? (
                <a href={url.prev} class={linkClass} rel="prev">
                    &larr; Previous
                </a>
            ) : (
                <span class={disabledClass} aria-hidden="true">
                    &larr; Previous
                </span>
            )}

            <span class="font-legend text-[15px] uppercase tracking-[0.16em] text-legend-soft">
                Course {currentPage} of {lastPage}
            </span>

            {url.next ? (
                <a href={url.next} class={linkClass} rel="next">
                    Next &rarr;
                </a>
            ) : (
                <span class={disabledClass} aria-hidden="true">
                    Next &rarr;
                </span>
            )}
        </nav>
    )
}
