---
import CategoryMark from './category-mark.astro';
import { getCategoryCounts } from '../../lib/posts';

// Counts and examples come from the published posts, so the album never
// claims a number the archive cannot back up.
const groups = getCategoryCounts();
---

<section class="border-t border-edge pt-9">
    <h2 class="font-caption text-[13px] tracking-[0.16em] text-ink-2">
        THE ALBUM, SHELF BY SHELF
    </h2>

    <ul class="mt-5 flex flex-col">
        {
            groups.map((group) => (
                <li class="border-t border-edge last:border-b">
                    <a
                        href={`/posts/${group.group}`}
                        class="group flex items-center gap-4 py-5 md:gap-6"
                        aria-label={`${group.label} — ${group.count} entries`}
                    >
                        <span class="w-6 shrink-0 text-ink-2 transition-colors group-hover:text-ink">
                            <CategoryMark group={group.group} size={22} />
                        </span>
                        <span class="w-[112px] shrink-0 text-[17px] font-semibold text-ink md:w-[150px] md:text-[19px]">
                            {group.label}
                        </span>
                        <span class="w-[86px] shrink-0 font-caption text-[12px] tracking-[0.1em] text-ink-2 md:w-[96px] md:text-[13px]">
                            {group.count} ENTRIES
                        </span>
                        <span class="hidden min-w-0 flex-1 truncate text-[15px] leading-6 text-ink-2 lg:block">
                            {group.examples.join(', ')}
                        </span>
                        <svg
                            class="ml-auto w-5 shrink-0 text-ink transition-transform group-hover:translate-x-1 lg:ml-0"
                            width="20"
                            height="14"
                            viewBox="0 0 20 14"
                            fill="none"
                            aria-hidden="true"
                        >
                            <path
                                d="M1 7h17M12.5 1.5 18 7l-5.5 5.5"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </a>
                </li>
            ))
        }
    </ul>
</section>
