---
import MountedPhoto from './mounted-photo.astro';
import CategoryMark from './category-mark.astro';
import { albumGroup, GROUP_LABELS } from '../../lib/posts';

export interface Props {
    title: string;
    slug: string;
    image: string;
    categories: string[];
    description?: string;
    date: string;
}

const { title, slug, image, categories, description, date } = Astro.props;

const group = albumGroup(categories);
const stamped = new Date(date).toLocaleDateString('en-GB', {
    month: 'short',
    year: 'numeric',
});
---

<!-- Only the title is a link. Wrapping the whole card made the accessible name
     a paragraph — photo alt, title, category, date and excerpt run together in
     a screen reader's link list. The stretched pseudo-element keeps the whole
     card clickable without putting any of that inside the link. -->
<article class="album-entry group relative">
    <div class="flex flex-col gap-3.5">
        <div aria-hidden="true">
            <MountedPhoto
                src={image}
                alt=""
                corner={26}
                class="h-[212px] w-full sm:h-[236px]"
            />
        </div>

        <!-- Title leads; the caption sits under it, the way it does on a leaf.
             Two lines are reserved from sm up, so captions across a row sit in
             one lane regardless of title length. Below sm there is no row to
             align to, and reserving the line just gaps every short title. -->
        <h3
            class="line-clamp-2 text-[21px] font-semibold leading-7 tracking-[-0.015em] text-ink decoration-ink-2/50 underline-offset-4 group-hover:underline sm:min-h-[3.5rem]"
        >
            <a href={slug} class="after:absolute after:inset-0">{title}</a>
        </h3>

        <div class="flex items-center gap-2 text-ink-2">
            <CategoryMark group={group} size={15} />
            <span class="font-caption text-[12px] tracking-[0.14em]">
                {group ? GROUP_LABELS[group].toUpperCase() : 'ENTRY'} · {
                    stamped.toUpperCase()
                }
            </span>
        </div>

        <!-- Measure capped on the paragraph, not the grid: in the two-column
             card the excerpt would otherwise run ~95ch while its neighbours
             run 45. -->
        {
            description && (
                <p class="max-w-[68ch] text-[15px] leading-6 text-ink-2">
                    {description}
                </p>
            )
        }
    </div>
</article>

<style>
    /* One authored moment: entries settle onto the leaf as they come into view.
       Visible by default — the class is only added once the observer runs, so
       nothing is hidden if JS never arrives. */
    .album-entry.is-settling {
        opacity: 0;
        transform: translateY(14px);
    }
    .album-entry.is-settled {
        opacity: 1;
        transform: none;
        transition:
            opacity 620ms cubic-bezier(0.16, 1, 0.3, 1),
            transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    @media (prefers-reduced-motion: reduce) {
        .album-entry.is-settling,
        .album-entry.is-settled {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>

<script>
    // Astro bundles this once, however many entries are on the page.
    //
    // The entries are visible in the markup and only ever hidden by script,
    // so any failure here leaves readable content rather than a blank page:
    // cards already on screen settle immediately, and a failsafe reveals
    // everything shortly after load whatever the observer does.
    const entries = Array.from(
        document.querySelectorAll<HTMLElement>('.album-entry')
    );
    const reduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
    ).matches;

    const settle = (entry: HTMLElement, order = 0) => {
        entry.style.transitionDelay = `${Math.min(order, 3) * 70}ms`;
        entry.classList.remove('is-settling');
        entry.classList.add('is-settled');
    };

    if (entries.length && !reduced && 'IntersectionObserver' in window) {
        const belowFold = entries.filter((entry) => {
            const inView = entry.getBoundingClientRect().top < window.innerHeight;
            if (!inView) entry.classList.add('is-settling');
            return !inView;
        });

        const observer = new IntersectionObserver(
            (records) => {
                records.forEach((record, index) => {
                    if (!record.isIntersecting) return;
                    settle(record.target as HTMLElement, index);
                    observer.unobserve(record.target);
                });
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );

        belowFold.forEach((entry) => observer.observe(entry));

        // Failsafe: never leave an entry hidden.
        window.setTimeout(() => {
            belowFold.forEach((entry) => {
                if (entry.classList.contains('is-settling')) settle(entry);
            });
        }, 1600);
    }
</script>
