---
// The oxblood book cloth. A vertical spine on desktop with the name blocked
// letter by letter, the way a narrow album spine is actually stamped; a
// horizontal cloth band on mobile, where vertical letterforms do not survive
// 390px. Fixed on desktop so it runs the full height of every page.
//
// The brush wordmark is red (#c0392b) and the cloth is oxblood (#7e1220) —
// 1.9:1, invisible. So it is pasted on a pale label the way an album spine
// actually carries its title: cream plate, red mark, 4.46:1.
const letters = 'LOUGHNANE'.split('');
---

<!-- Desktop: the spine -->
<div
    class="fixed left-0 top-0 z-30 hidden h-screen w-[84px] flex-col items-center justify-center overflow-hidden bg-cloth md:flex"
>
    <!-- Reading depth, filling down the cloth as you scroll. -->
    <div id="spine-progress" aria-hidden="true" class="spine-fill bg-cloth"></div>

    <!-- The M straight onto the cloth. Inlined rather than linked as an image
         so it takes the on-cloth token and costs no extra request; the viewBox
         is cropped to the artwork so the mark fills its box rather than sitting
         in the source file's padding. -->
    <a
        href="/"
        aria-label="Mat Loughnane — home"
        class="absolute left-1/2 top-7 -translate-x-1/2 text-on-cloth"
    >
        <svg
            width="46"
            height="31"
            viewBox="0 74.96 491.52 327.68"
            fill="currentColor"
            aria-hidden="true"
            class="block"
        >
            <path d="M163.84,74.96l163.84,327.68l-327.68,0l163.84,-327.68Z"></path>
            <path d="M327.68,74.96l163.84,327.68l-327.68,0l163.84,-327.68Z"></path>
        </svg>
    </a>

    <div class="relative flex flex-col items-center" aria-hidden="true">
        {
            letters.map((letter) => (
                <span
                    class="font-display text-[19px] leading-5 tracking-[0.02em] text-on-cloth"
                >
                    {letter}
                </span>
            ))
        }
    </div>
</div>

<!-- Mobile: the same cloth, laid flat -->
<div class="flex items-center justify-between bg-cloth px-5 py-3 md:hidden">
    <!-- Mobile has width the spine does not, so the mark is joined by the name
         set beside it rather than carrying it alone. -->
    <a
        href="/"
        aria-label="Mat Loughnane — home"
        class="inline-flex items-center gap-3 text-on-cloth"
    >
        <svg
            width="34"
            height="23"
            viewBox="0 74.96 491.52 327.68"
            fill="currentColor"
            aria-hidden="true"
            class="block shrink-0"
        >
            <path d="M163.84,74.96l163.84,327.68l-327.68,0l163.84,-327.68Z"></path>
            <path d="M327.68,74.96l163.84,327.68l-327.68,0l163.84,-327.68Z"></path>
        </svg>
        <span
            class="font-display text-[15px] tracking-[0.12em]"
            aria-hidden="true">MAT LOUGHNANE</span
        >
    </a>
</div>

<style>
    /* A shade deeper than the cloth, so the fill reads as the same cloth in
       shadow rather than a second colour. Deliberately not --album-reserve,
       which is spent only on the newest entry. */
    /* Scaled, not resized: animating height relayouts the fixed spine on every
       scroll frame, while a scaleY stays on the compositor. */
    .spine-fill {
        position: absolute;
        inset-inline: 0;
        top: 0;
        height: 100%;
        transform: scaleY(0);
        transform-origin: top;
        /* `bg-cloth` on the element carries the crosshatch weave through the
           fill; only the colour underneath it changes. background-color, not
           the shorthand, so that background-image survives. */
        background-color: #5e0d18;
        transition: transform 120ms linear;
    }

    @media (prefers-reduced-motion: reduce) {
        .spine-fill {
            transition: none;
        }
    }

</style>

<script>
    // Scroll depth as a height percentage on the fill. Read once per frame:
    // scrollHeight/innerHeight are layout reads and scroll fires far faster
    // than paint.
    const fill = document.getElementById('spine-progress');

    if (fill) {
        let queued = false;

        const update = () => {
            queued = false;
            const scrollable =
                document.documentElement.scrollHeight - window.innerHeight;
            const progress =
                scrollable > 0
                    ? Math.min(100, Math.max(0, (window.scrollY / scrollable) * 100))
                    : 0;
            fill.style.transform = `scaleY(${progress / 100})`;
        };

        const queue = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(update);
        };

        update();
        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue, { passive: true });
    }
</script>
