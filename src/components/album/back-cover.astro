---
// The album closes on the same cloth it opens with.
const elsewhere = [
    { label: 'hexa studios', href: 'https://hexastudios.co' },
    { label: 'github', href: 'https://github.com/matloughnane' },
    { label: 'linkedin', href: 'https://linkedin.com/in/matloughnane' },
];
---

<footer
    class="mt-24 flex flex-col gap-10 bg-cloth px-5 py-12 md:flex-row md:items-end md:justify-between md:px-14 md:py-14"
>
    <div class="flex flex-col gap-4">
        <span
            class="font-caption text-[13px] tracking-[0.16em] text-on-cloth/75"
        >
            MAT LOUGHNANE · DUBLIN
        </span>
        <div class="flex flex-row flex-wrap gap-6">
            {
                elsewhere.map((link) => (
                    <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[15px] font-medium text-on-cloth underline decoration-on-cloth/40 transition-colors hover:decoration-on-cloth"
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>
    </div>

    <span
        class="font-display text-[38px] leading-none tracking-[-0.03em] text-on-cloth md:text-[46px]"
    >
        Mat Loughnane
    </span>
</footer>
