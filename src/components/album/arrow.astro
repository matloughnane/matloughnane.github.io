---
// One drawn arrow for the whole album. Replaces the &rarr; / &larr; glyphs that
// were mixing a unicode icon system into a page that otherwise draws its marks,
// at the same 1.6 stroke as the category marks.
export interface Props {
    direction?: 'left' | 'right';
    class?: string;
}

const { direction = 'right', class: className = '' } = Astro.props;
---

<svg
    class:list={['shrink-0', className]}
    width="20"
    height="14"
    viewBox="0 0 20 14"
    fill="none"
    aria-hidden="true"
>
    {
        direction === 'right' ? (
            <path
                d="M1 7h17M12.5 1.5 18 7l-5.5 5.5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
            />
        ) : (
            <path
                d="M19 7H2M7.5 1.5 2 7l5.5 5.5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
            />
        )
    }
</svg>
