---
// The album's core motif: a photograph framed by four oxblood corner marks.
// The marks sit in a small margin around the photo rather than over it, so
// nothing covers the picture. Each mark is its own fixed-size SVG, so they
// stay square and symmetrical at any container size.
export interface Props {
    src: string;
    alt: string;
    /** Utility classes for the frame — set the size here (e.g. "h-72 w-full"). */
    class?: string;
    /** Length of each corner mark's arms in px. Scale down for smaller photos. */
    corner?: number;
    loading?: 'eager' | 'lazy';
}

const {
    src,
    alt,
    class: className = '',
    corner = 30,
    loading = 'lazy',
} = Astro.props;

const c = corner;
// Stroke weight and the gap between mark and photo scale gently with size.
const w = c >= 30 ? 3 : 2.5;
const gap = Math.round(c / 5);
const h = w / 2;
// One L, drawn for the top-left; the other three are mirrors of it.
const d = `M${h} ${c} V${h} H${c}`;

const marks = [
    { pos: 'left-0 top-0', flip: '' },
    { pos: 'right-0 top-0', flip: `matrix(-1 0 0 1 ${c} 0)` },
    { pos: 'bottom-0 left-0', flip: `matrix(1 0 0 -1 0 ${c})` },
    { pos: 'bottom-0 right-0', flip: `matrix(-1 0 0 -1 ${c} ${c})` },
];
---

<div
    class:list={['album-photo relative', className]}
    style={`--mount-gap: ${gap + w}px;`}
>
    <div
        class="absolute overflow-hidden bg-leaf"
        style="inset: var(--mount-gap);"
    >
        <img
            src={src}
            alt={alt}
            loading={loading}
            decoding="async"
            class="block h-full w-full object-cover"
        />
    </div>
    <span class="pointer-events-none absolute inset-0" aria-hidden="true">
        {
            marks.map((m, i) => (
                <svg
                    class:list={['album-corner absolute', m.pos]}
                    data-corner={i}
                    width={c}
                    height={c}
                    viewBox={`0 0 ${c} ${c}`}
                    fill="none"
                >
                    <path
                        d={d}
                        transform={m.flip || undefined}
                        stroke="var(--album-mount)"
                        stroke-width={w}
                        stroke-linecap="square"
                    />
                </svg>
            ))
        }
    </span>
</div>

<style>
    /* The album's native motion: the marks close in on the photo. */
    .album-corner {
        transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
        --pull: 3px;
    }

    :global(a:hover) .album-photo .album-corner[data-corner='0'],
    .album-photo:hover .album-corner[data-corner='0'] {
        transform: translate(var(--pull), var(--pull));
    }
    :global(a:hover) .album-photo .album-corner[data-corner='1'],
    .album-photo:hover .album-corner[data-corner='1'] {
        transform: translate(calc(var(--pull) * -1), var(--pull));
    }
    :global(a:hover) .album-photo .album-corner[data-corner='2'],
    .album-photo:hover .album-corner[data-corner='2'] {
        transform: translate(var(--pull), calc(var(--pull) * -1));
    }
    :global(a:hover) .album-photo .album-corner[data-corner='3'],
    .album-photo:hover .album-corner[data-corner='3'] {
        transform: translate(calc(var(--pull) * -1), calc(var(--pull) * -1));
    }

    @media (prefers-reduced-motion: reduce) {
        .album-corner {
            transition: none;
        }
        :global(a:hover) .album-photo .album-corner,
        .album-photo:hover .album-corner {
            transform: none !important;
        }
    }
</style>
