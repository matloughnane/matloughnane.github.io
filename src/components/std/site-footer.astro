---
const elsewhere = [
    { label: 'Hexa Studios', href: 'https://hexastudios.co' },
    { label: 'GitHub', href: 'https://github.com/matloughnane' },
    { label: 'LinkedIn', href: 'https://linkedin.com/in/matloughnane' },
];
const year = new Date().getFullYear();
---

<footer
    class="mt-20 flex flex-col gap-4 border-t border-line py-8 sm:flex-row sm:items-center sm:justify-between"
>
    <div class="flex flex-wrap items-center gap-4">
        {
            elsewhere.map((link) => (
                <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[14px] text-fg-muted transition-colors hover:text-fg"
                >
                    {link.label}
                </a>
            ))
        }
    </div>
    <span class="font-mono text-[13px] text-fg-muted">
        © {year} Mat Loughnane
    </span>
</footer>
